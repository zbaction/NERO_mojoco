<mujoco model="desk_three_cubes">
  <!-- 一张桌子 + 桌面上三个不同颜色的方块 -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight ambient="0.30 0.30 0.32" diffuse="0.55 0.55 0.55" specular="0.08 0.08 0.08"/>
    <map znear="0.01" zfar="30"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.32 0.36 0.42" rgb2="0.04 0.05 0.07" width="512" height="512"/>
    <texture name="floor_grid" type="2d" builtin="checker"
             rgb1="0.27 0.29 0.32" rgb2="0.22 0.24 0.27" width="512" height="512"/>
    <material name="floor_mat" texture="floor_grid" texrepeat="8 8" reflectance="0.03"/>
    <material name="wood"      rgba="0.66 0.46 0.30 1" specular="0.25" shininess="0.25" reflectance="0.02"/>
    <material name="leg_mat"   rgba="0.30 0.33 0.38 1" specular="0.4" shininess="0.5"/>
    <material name="mat_red"   rgba="0.86 0.13 0.13 1" specular="0.3" shininess="0.6"/>
    <material name="mat_green" rgba="0.12 0.68 0.26 1" specular="0.3" shininess="0.6"/>
    <material name="mat_blue"  rgba="0.16 0.34 0.86 1" specular="0.3" shininess="0.6"/>
  </asset>

  <worldbody>
    <!-- 灯光 -->
    <light name="key"  pos="0.8 -0.9 2.0" dir="-0.4 0.45 -1" directional="true"
           diffuse="0.62 0.62 0.62" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="fill" pos="-1.0 1.2 1.6" dir="0.5 -0.6 -1" diffuse="0.28 0.28 0.30"/>

    <!-- 地面 -->
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <!-- 桌子：桌面 0.8m(x) × 1.2m(y)，台面高 0.74m -->
    <body name="table" pos="0 0 0">
      <geom name="table_top" type="box" pos="0 0 0.72" size="0.40 0.60 0.02"
            material="wood" friction="0.9 0.02 0.002"/>
      <geom name="leg_0" type="box" pos=" 0.355  0.555 0.35" size="0.022 0.022 0.35" material="leg_mat"/>
      <geom name="leg_1" type="box" pos="-0.355  0.555 0.35" size="0.022 0.022 0.35" material="leg_mat"/>
      <geom name="leg_2" type="box" pos=" 0.355 -0.555 0.35" size="0.022 0.022 0.35" material="leg_mat"/>
      <geom name="leg_3" type="box" pos="-0.355 -0.555 0.35" size="0.022 0.022 0.35" material="leg_mat"/>
      <!-- 横撑，视觉上更像一张桌子 -->
      <geom name="rail_x" type="box" pos="0 0.555 0.10" size="0.355 0.012 0.012" material="leg_mat"/>
      <geom name="rail_y" type="box" pos="0.355 0 0.10" size="0.012 0.555 0.012" material="leg_mat"/>
    </body>

    <!-- 三个方块：边长 10cm，摆在台面上（z = 0.74 + 0.05 = 0.79） -->
    <body name="cube_red" pos="0 -0.26 0.79" euler="0 0 12">
      <freejoint name="cube_red_free"/>
      <geom name="cube_red_geom" type="box" size="0.05 0.05 0.05" material="mat_red"
            friction="1.0 0.02 0.002"/>
    </body>

    <body name="cube_green" pos="0.03 0.0 0.79" euler="0 0 -8">
      <freejoint name="cube_green_free"/>
      <geom name="cube_green_geom" type="box" size="0.05 0.05 0.05" material="mat_green"
            friction="1.0 0.02 0.002"/>
    </body>

    <body name="cube_blue" pos="-0.02 0.26 0.79" euler="0 0 20">
      <freejoint name="cube_blue_free"/>
      <geom name="cube_blue_geom" type="box" size="0.05 0.05 0.05" material="mat_blue"
            friction="1.0 0.02 0.002"/>
    </body>

    <!-- 预设视角 -->
    <camera name="overview" pos="1.35 -1.55 1.35" xyaxes="0.75 0.66 0 -0.30 0.34 0.89" fovy="45"/>
    <camera name="front"    pos="0 -1.85 1.05"  xyaxes="1 0 0 0 0.42 0.91" fovy="40"/>
    <camera name="top"      pos="0 0 2.20"     xyaxes="1 0 0 0 1 0" fovy="50"/>
  </worldbody>
</mujoco>
